<UserControl x:Class="Flow.Launcher.Plugin.NaverMapSearch.Settings.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="300">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="네이버 지역 검색 설정" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="본인의 네이버 개발자 센터에서 발급한 인증값을 입력하세요. 애플리케이션의 사용 API에 ‘검색’을 선택해야 합니다."
                       TextWrapping="Wrap" Margin="0,0,0,16"/>
            <Label Content="X-Naver-Client-Id" Target="{Binding ElementName=ClientIdBox}" Padding="0,0,0,6"/>
            <TextBox x:Name="ClientIdBox" AutomationProperties.Name="X-Naver-Client-Id" MinWidth="280" Margin="0,0,0,16"/>
            <Label Content="X-Naver-Client-Secret" Target="{Binding ElementName=ClientSecretBox}" Padding="0,0,0,6"/>
            <PasswordBox x:Name="ClientSecretBox" AutomationProperties.Name="X-Naver-Client-Secret" MinWidth="280" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="SaveButton" Content="저장" Padding="20,6" Click="Save_Click" Margin="0,0,12,0"/>
                <Button Content="인증값 발급 안내" Padding="12,6" Click="Help_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,16"/>
            <TextBlock Text="인증값은 현재 Windows 사용자 계정으로 암호화하여 이 PC에 저장합니다. 다른 PC나 Windows 계정에서는 다시 입력하세요. 저장한 값은 다음 검색부터 바로 적용됩니다."
                       TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,12"/>
            <TextBlock Text="사용 예: nm 강남 카페 · 검색 결과는 최대 5개입니다. Enter를 누르면 네이버 지도에서 장소명과 주소를 검색합니다."
                       TextWrapping="Wrap" Opacity="0.8"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
