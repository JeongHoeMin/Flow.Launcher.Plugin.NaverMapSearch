<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Flow.Launcher.Plugin" Version="5.3.1" ExcludeAssets="runtime" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.9" />
    <InternalsVisibleTo Include="NaverMapSearch.Tests" />
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
